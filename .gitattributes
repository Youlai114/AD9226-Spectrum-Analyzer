# 仓库里 core.autocrlf=true(Windows), 若不钉死 EOL, 重新 checkout 会把
# run_regression.sh 变成 CRLF 导致 Git Bash 报 "$'\r': command not found"
*.sh    text eol=lf
*.py    text eol=lf
*.v     text eol=lf
*.sv    text eol=lf
*.vh    text eol=lf
*.md    text eol=lf
*.cst   text eol=lf
*.sdc   text eol=lf
*.tcl   text eol=lf
*.ipc   text eol=lf
*.txt   text eol=lf
VERSION text eol=lf
LICENSE text eol=lf

# 二进制: 不做行尾转换
*.docx binary
*.doc  binary
*.fs   binary
*.png  binary
*.ppm  binary
*.zip  binary
*.vo   binary
*.hex  binary
*.pof  binary
*.bit  binary

# ---- GitHub Linguist ----
# .fs 是 Gowin 综合/布线产出的比特流, 不是 F#; .pof/.bit/.vo 是 EDA 产物。
# 不排除的话 GitHub 会把整个仓库的语言判成 "F#", 语言条完全失真。
*.fs   -linguist-detectable
*.pof  -linguist-detectable
*.bit  -linguist-detectable
*.vo   -linguist-detectable
*.hex  -linguist-detectable
impl/**      linguist-vendored
*.v    linguist-language=Verilog
*.vh   linguist-language=Verilog
*.sv   linguist-language=SystemVerilog
*.vhd  linguist-language=VHDL
